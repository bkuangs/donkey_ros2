<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_car">

  <xacro:include filename="$(find robot_description)/urdf/robot_car.urdf.xacro" />
  <xacro:include filename="$(find robot_sim)/urdf/sim_camera.xacro" />
  <xacro:include filename="$(find robot_sim)/urdf/sim_ground_truth.xacro" />
  <xacro:include filename="$(find robot_sim)/urdf/ros2_control.xacro"/>

</robot>