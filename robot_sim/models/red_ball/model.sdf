<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="red_ball">
    <link name="ball">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.008</ixx>
          <iyy>0.008</iyy>
          <izz>0.008</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.2</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.2</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- v=0.4 m/s and yaw_rate=v/r=0.1333 rad/s produce a 3 m circle. -->
    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <initial_linear>0.4 0 0</initial_linear>
      <initial_angular>0 0 0.1333333333</initial_angular>
    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>red_ball</robot_base_frame>
      <odom_topic>/target/ground_truth/odom</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
