<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="intercept_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.75 0.75 0.75 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light type="point" name="fill_light_north">
      <pose>-3 3 4 0 0 0</pose>
      <diffuse>0.45 0.45 0.45 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <light type="point" name="fill_light_south">
      <pose>3 -3 4 0 0 0</pose>
      <diffuse>0.45 0.45 0.45 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name="arena">
      <static>true</static>
      <link name="arena">
        <collision name="floor">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>12 12 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>12 12 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.14 0.16 1</ambient>
            <diffuse>0.16 0.18 0.20 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- High-contrast one-meter grid makes motion easy to inspect visually. -->
        <visual name="grid_x_m5"><pose>-5 0 0.002 0 0 0</pose><geometry><box><size>0.025 12 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_x_m4"><pose>-4 0 0.002 0 0 0</pose><geometry><box><size>0.025 12 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_x_m3"><pose>-3 0 0.002 0 0 0</pose><geometry><box><size>0.025 12 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_x_m2"><pose>-2 0 0.002 0 0 0</pose><geometry><box><size>0.025 12 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_x_m1"><pose>-1 0 0.002 0 0 0</pose><geometry><box><size>0.025 12 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_x_0"><pose>0 0 0.002 0 0 0</pose><geometry><box><size>0.025 12 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_x_1"><pose>1 0 0.002 0 0 0</pose><geometry><box><size>0.025 12 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_x_2"><pose>2 0 0.002 0 0 0</pose><geometry><box><size>0.025 12 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_x_3"><pose>3 0 0.002 0 0 0</pose><geometry><box><size>0.025 12 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_x_4"><pose>4 0 0.002 0 0 0</pose><geometry><box><size>0.025 12 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_x_5"><pose>5 0 0.002 0 0 0</pose><geometry><box><size>0.025 12 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_y_m5"><pose>0 -5 0.002 0 0 0</pose><geometry><box><size>12 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_y_m4"><pose>0 -4 0.002 0 0 0</pose><geometry><box><size>12 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_y_m3"><pose>0 -3 0.002 0 0 0</pose><geometry><box><size>12 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_y_m2"><pose>0 -2 0.002 0 0 0</pose><geometry><box><size>12 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_y_m1"><pose>0 -1 0.002 0 0 0</pose><geometry><box><size>12 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_y_0"><pose>0 0 0.002 0 0 0</pose><geometry><box><size>12 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_y_1"><pose>0 1 0.002 0 0 0</pose><geometry><box><size>12 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_y_2"><pose>0 2 0.002 0 0 0</pose><geometry><box><size>12 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_y_3"><pose>0 3 0.002 0 0 0</pose><geometry><box><size>12 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_y_4"><pose>0 4 0.002 0 0 0</pose><geometry><box><size>12 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
        <visual name="grid_y_5"><pose>0 5 0.002 0 0 0</pose><geometry><box><size>12 0.025 0.004</size></box></geometry><material><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>

        <collision name="north_wall"><pose>0 6.1 1 0 0 0</pose><geometry><box><size>12.4 0.2 2</size></box></geometry></collision>
        <visual name="north_wall"><pose>0 6.1 1 0 0 0</pose><geometry><box><size>12.4 0.2 2</size></box></geometry><material><diffuse>0.65 0.70 0.75 1</diffuse></material></visual>
        <collision name="south_wall"><pose>0 -6.1 1 0 0 0</pose><geometry><box><size>12.4 0.2 2</size></box></geometry></collision>
        <visual name="south_wall"><pose>0 -6.1 1 0 0 0</pose><geometry><box><size>12.4 0.2 2</size></box></geometry><material><diffuse>0.70 0.65 0.60 1</diffuse></material></visual>
        <collision name="east_wall"><pose>6.1 0 1 0 0 0</pose><geometry><box><size>0.2 12 2</size></box></geometry></collision>
        <visual name="east_wall"><pose>6.1 0 1 0 0 0</pose><geometry><box><size>0.2 12 2</size></box></geometry><material><diffuse>0.60 0.70 0.62 1</diffuse></material></visual>
        <collision name="west_wall"><pose>-6.1 0 1 0 0 0</pose><geometry><box><size>0.2 12 2</size></box></geometry></collision>
        <visual name="west_wall"><pose>-6.1 0 1 0 0 0</pose><geometry><box><size>0.2 12 2</size></box></geometry><material><diffuse>0.72 0.62 0.68 1</diffuse></material></visual>

        <!-- Distinct wall markers improve feature distribution above the floor. -->
        <visual name="marker_n1"><pose>-4 5.99 1.1 0 0 0</pose><geometry><box><size>0.7 0.02 0.7</size></box></geometry><material><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
        <visual name="marker_n2"><pose>-2 5.99 0.8 0 0 0</pose><geometry><box><size>0.5 0.02 0.9</size></box></geometry><material><diffuse>0.9 0.9 0.2 1</diffuse></material></visual>
        <visual name="marker_n3"><pose>0 5.99 1.2 0 0 0</pose><geometry><box><size>0.8 0.02 0.5</size></box></geometry><material><diffuse>0.1 0.3 0.9 1</diffuse></material></visual>
        <visual name="marker_n4"><pose>2 5.99 0.9 0 0 0</pose><geometry><box><size>0.6 0.02 0.8</size></box></geometry><material><diffuse>0.2 0.8 0.9 1</diffuse></material></visual>
        <visual name="marker_n5"><pose>4 5.99 1.3 0 0 0</pose><geometry><box><size>0.4 0.02 0.6</size></box></geometry><material><diffuse>0.1 0.8 0.3 1</diffuse></material></visual>
        <visual name="marker_e1"><pose>5.99 -4 1.0 0 0 0</pose><geometry><box><size>0.02 0.6 0.8</size></box></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
        <visual name="marker_e2"><pose>5.99 -2 1.3 0 0 0</pose><geometry><box><size>0.02 0.8 0.4</size></box></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="marker_e3"><pose>5.99 0 0.8 0 0 0</pose><geometry><box><size>0.02 0.5 0.9</size></box></geometry><material><diffuse>0.9 0.45 0.1 1</diffuse></material></visual>
        <visual name="marker_e4"><pose>5.99 2 1.2 0 0 0</pose><geometry><box><size>0.02 0.7 0.6</size></box></geometry><material><diffuse>0.2 0.6 0.9 1</diffuse></material></visual>
        <visual name="marker_e5"><pose>5.99 4 0.9 0 0 0</pose><geometry><box><size>0.02 0.4 0.7</size></box></geometry><material><diffuse>0.8 0.2 0.7 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
