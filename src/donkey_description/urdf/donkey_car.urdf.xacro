<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="donkey_car">

  <xacro:include filename="$(find donkey_description)/urdf/donkey_base.xacro" />
  <xacro:include filename="$(find donkey_description)/urdf/sensors/camera.xacro" />
  <xacro:include filename="$(find donkey_description)/urdf/sensors/imu.xacro" />
  <xacro:include filename="$(find donkey_sim)/urdf/ros2_control.xacro"/>

  <xacro:donkey_camera parent="base_link" xyz="0.14 0 0.07" rpy="0 0 0" />
  <xacro:donkey_imu    parent="base_link" xyz="0.0 0 0.04"  rpy="0 0 0" />

</robot>