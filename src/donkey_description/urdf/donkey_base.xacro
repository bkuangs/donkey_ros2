<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="chassis_length" value="0.32"/>
  <xacro:property name="chassis_width"  value="0.18"/>
  <xacro:property name="chassis_height" value="0.06"/>

  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width"  value="0.025"/>

  <xacro:property name="front_x" value="0.12"/>
  <xacro:property name="rear_x"  value="-0.12"/>
  <xacro:property name="left_y"  value="0.09"/>
  <xacro:property name="right_y" value="-0.09"/>

  <xacro:property name="chassis_clearance" value="0.015"/> 
  <xacro:property name="base_z" value="${wheel_radius + 0.035}"/>

  <material name="black"><color rgba="0.02 0.02 0.02 1.0"/></material>
  <material name="gray"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.3 0.9 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <xacro:macro name="wheel" params="name parent x y steerable">

    <xacro:if value="${steerable}">
      <link name="${name}_steer_link">
        <visual>
          <geometry><box size="0.02 0.02 0.02"/></geometry>
          <material name="gray"/>
        </visual>
        <collision>
          <geometry><box size="0.02 0.02 0.02"/></geometry>
        </collision>
        <inertial>
          <mass value="0.05"/> <origin xyz="0 0 0"/>
          <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
        </inertial>
      </link>

      <joint name="${name}_steer_joint" type="revolute">
        <parent link="${parent}"/>
        <child link="${name}_steer_link"/>
        <origin xyz="${x} ${y} -0.035" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.6" upper="0.6" effort="10.0" velocity="5.0"/>
      </joint>

      <link name="${name}_wheel_link">
        <visual>
          <origin xyz="0 0 0" rpy="1.5708 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
          <material name="black"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="1.5708 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <inertial>
          <mass value="0.05"/>
          <origin xyz="0 0 0"/>
          <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
        </inertial>
      </link>

      <joint name="${name}_wheel_joint" type="continuous">
        <parent link="${name}_steer_link"/>
        <child link="${name}_wheel_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="5.0" velocity="50.0"/>
      </joint>
    </xacro:if>

    <xacro:unless value="${steerable}">
      <link name="${name}_wheel_link">
        <visual>
          <origin xyz="0 0 0" rpy="1.5708 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
          <material name="black"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="1.5708 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <inertial>
          <mass value="0.05"/>
          <origin xyz="0 0 0"/>
          <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
        </inertial>
      </link>

      <joint name="${name}_wheel_joint" type="continuous">
        <parent link="${parent}"/>
        <child link="${name}_wheel_link"/>
        <origin xyz="${x} ${y} -0.035" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="5.0" velocity="50.0"/>
      </joint>
    </xacro:unless>

    <gazebo reference="${name}_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1 value="1.5"/>
      <mu2 value="1.5"/>
      <kp value="1000000.0"/>
      <kd value="1.0"/>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="front_left"  parent="base_link" x="${front_x}" y="${left_y}"  steerable="true"/>
  <xacro:wheel name="front_right" parent="base_link" x="${front_x}" y="${right_y}" steerable="true"/>
  <xacro:wheel name="rear_left"   parent="base_link" x="${rear_x}"  y="${left_y}"  steerable="false"/>
  <xacro:wheel name="rear_right"  parent="base_link" x="${rear_x}"  y="${right_y}" steerable="false"/>

</robot>